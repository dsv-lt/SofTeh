# Внешний LLM провайдер (Groq Cloud, OpenRouter или Google AI Studio)
# Автоопределение по префиксу ключа при LLM_PROVIDER=auto:
#   gsk_...        -> Groq Cloud (llama-3.1-8b-instant)
#   sk-or-...      -> OpenRouter (meta-llama/llama-3.3-70b-instruct:free)
#   AQ.... / AIza  -> Google AI Studio (gemini-flash-lite-latest)
LLM_API_KEY=your_api_key_here
LLM_PROVIDER=auto

# Необязательные переопределения:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_TIMEOUT=60
# LLM_MAX_TOKENS=1024

# Локальный классификатор: lora (ruBERT-base + LoRA) или baseline (char TF-IDF + PyTorch MLP)
CLASSIFIER_BACKEND=lora
DEVICE=auto
