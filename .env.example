# Внешний LLM провайдер (Groq Cloud или OpenRouter)
# Ключ с префиксом gsk_ автоматически направляется в Groq (llama-3.1-8b-instant),
# с префиксом sk-or- — в OpenRouter (meta-llama/llama-3.3-70b-instruct:free).
LLM_API_KEY=your_api_key_here
LLM_PROVIDER=auto

# Необязательные переопределения:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_TIMEOUT=60
# LLM_MAX_TOKENS=800

# Локальный классификатор: lora (ruBERT-base + LoRA) или baseline (char TF-IDF + PyTorch MLP)
CLASSIFIER_BACKEND=lora
DEVICE=auto
